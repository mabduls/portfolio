{
  "name": "portofolio-fe",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "server:staging": "cross-env NODE_ENV=staging node server.js",
    "preview": "vite preview",
    "lint": "npm run lint:oxlint && npm run lint:eslint",
    "lint:oxlint": "oxlint .",
    "lint:eslint": "eslint . --cache",
    "lint:fix": "npm run lint:oxlint:fix && npm run lint:eslint:fix",
    "lint:oxlint:fix": "oxlint . --fix",
    "lint:eslint:fix": "eslint . --fix --cache",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run format:check && npm run test:unit && npm run build",
    "prepare": "husky"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "cross-env": "^10.1.0",
    "fastify": "^5.12.3",
    "vue": "3.5.42",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.1.13",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.73.0",
    "eslint-plugin-vue": "~10.9.2",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.1.6",
    "oxlint": "~1.73.0",
    "prettier": "3.9.5",
    "tailwindcss": "^4.1.13",
    "vite": "^8.1.5",
    "vitest": "^3.2.4",
    "vue-eslint-parser": "^10.4.1"
  },
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "lint-staged": {
    "*.{js,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md,yml,yaml}": "prettier --write"
  }
}
